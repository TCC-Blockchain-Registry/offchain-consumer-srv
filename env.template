# ==============================================================================
# BESU PROPERTY LEDGER API - Configurações
# ==============================================================================

# Ambiente
NODE_ENV=development
PORT=3000

# ==============================================================================
# BLOCKCHAIN - Conexão
# ==============================================================================

# URL do RPC da blockchain (Besu local)
RPC_URL=http://127.0.0.1:8545

# Chain ID da rede
CHAIN_ID=1337

# ==============================================================================
# PRIVATE KEYS - Carteiras dos diferentes roles
# ==============================================================================

# ⚠️ IMPORTANTE: NUNCA commite estas chaves em produção!
# Use apenas para desenvolvimento local

# Admin Wallet (AGENT_ROLE + DEFAULT_ADMIN_ROLE)
# Pode emitir títulos, congelar propriedades, gerenciar aprovadores
ADMIN_PRIVATE_KEY=0x51eba47406fcb3dfa80e9ff02c1a8efe1aa1552bf016e09d454e6a7502ef0c24

# Orchestrator Wallet (ORCHESTRATOR_ROLE)
# Pode configurar transferências
ORCHESTRATOR_PRIVATE_KEY=0xa35c6c2c0e71958cd70c97c841dd6f1a1d6c0a6d5ad3e3e3a39b1a6d3f3c3d3e

# Registrar Wallet (REGISTRAR_ROLE)
# Pode registrar propriedades no módulo de compliance
REGISTRAR_PRIVATE_KEY=0xb46d7d5f9c8e4a5f3c6b2d4e1f8a9c0d3e5f7a1b3c5d7e9f0a1b2c3d4e5f6a7b

# ==============================================================================
# ENDEREÇOS DOS CONTRATOS - Obtidos após deploy
# ==============================================================================

# Contrato principal de tokenização (PropertyTitleTREX)
PROPERTY_TITLE_ADDRESS=0xYourPropertyTitleAddress

# Módulo de aprovações (ApprovalsModule)
APPROVALS_MODULE_ADDRESS=0xYourApprovalsModuleAddress

# Módulo de registro (RegistryMDCompliance)
REGISTRY_MODULE_ADDRESS=0xYourRegistryModuleAddress

# Registro de aprovadores (ApproversRegistry)
APPROVERS_REGISTRY_ADDRESS=0xYourApproversRegistryAddress

# Identity Registry (T-REX)
IDENTITY_REGISTRY_ADDRESS=0xYourIdentityRegistryAddress

# Modular Compliance (T-REX)
MODULAR_COMPLIANCE_ADDRESS=0xYourModularComplianceAddress

# ==============================================================================
# NOTAS DE CONFIGURAÇÃO
# ==============================================================================

# 1. Como obter os endereços dos contratos após deploy:
#    - Verifique o arquivo deployed-addresses.txt na raiz do projeto
#    - Ou consulte os logs do deploy
#    - Ou use: forge script script/DeployPropertyTitleTREX.s.sol

# 2. Como obter as private keys:
#    - Para desenvolvimento local: use as chaves do Besu (genesis.json)
#    - Para produção: NUNCA use chaves hardcoded!
#      Use variáveis de ambiente seguras ou serviços como AWS Secrets Manager

# 3. Ordem de setup:
#    1. Deploy dos contratos (forge script)
#    2. Copiar endereços para este arquivo
#    3. Garantir que as wallets têm ETH suficiente
#    4. Registrar aprovadores (POST /api/approvers/register)
#    5. Pronto para usar!

# ==============================================================================
# WEBHOOK (Opcional - para notificações)
# ==============================================================================

# URL para enviar notificações de eventos
# WEBHOOK_URL=https://api.seuorquestrador.com/webhook

# API Key para autenticação do webhook
# WEBHOOK_API_KEY=seu-api-key-aqui

