# ==============================================================================
# BESU PROPERTY LEDGER API - Configurações
# ==============================================================================

# Ambiente
NODE_ENV=development
PORT=3000

# ==============================================================================
# BLOCKCHAIN - Conexão
# ==============================================================================

# URL do RPC da blockchain (Besu local)
RPC_URL=http://127.0.0.1:8545

# Chain ID da rede
CHAIN_ID=1337

# ==============================================================================
# PRIVATE KEYS - Carteiras dos diferentes roles
# ==============================================================================

# Admin Wallet (AGENT_ROLE + DEFAULT_ADMIN_ROLE)
ADMIN_PRIVATE_KEY=0x51eba47406fcb3dfa80e9ff02c1a8efe1aa1552bf016e09d454e6a7502ef0c24

# Orchestrator Wallet (ORCHESTRATOR_ROLE)
ORCHESTRATOR_PRIVATE_KEY=0xa35c6c2c0e71958cd70c97c841dd6f1a1d6c0a6d5ad3e3e3a39b1a6d3f3c3d3e

# Registrar Wallet (REGISTRAR_ROLE)
