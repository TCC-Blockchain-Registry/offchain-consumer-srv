							"raw": "{\n  \"approvers\": [\n    \"0x1234567890123456789012345678901234567890\",\n    \"0x2345678901234567890123456789012345678901\",\n    \"0x3456789012345678901234567890123456789012\"\n  ]\n}"
						},
