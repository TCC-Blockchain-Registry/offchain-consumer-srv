		{
			"name": "Properties (Propriedades)",
			"item": [
				{
					"name": "Register Property",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"matriculaId\": 123456,\n  \"folha\": 100,\n  \"comarca\": \"São Paulo\",\n  \"endereco\": \"Rua Exemplo, 123 - Centro - São Paulo/SP\",\n  \"metragem\": 150,\n  \"proprietario\": \"0x565524f400856766f11562832eB809d889491a01\",\n  \"matriculaOrigem\": 0,\n  \"tipo\": 0,\n  \"isRegular\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/properties/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "properties", "register"]
						},
						"description": "Registra um novo imóvel (fluxo completo).\n\nExecuta automaticamente:\n1. Registro no RegistryMDCompliance\n2. Emissão de título no PropertyTitleTREX\n\nTipos:\n- 0 = URBANO\n- 1 = RURAL\n- 2 = LITORAL"
					},
					"response": []
				},
