							"host": ["{{baseUrl}}"],
							"path": ["api", "properties", "123456"]
						},
						"description": "Retorna informações completas de um imóvel (compliance + token)"
					},
					"response": []
				},
				{
					"name": "Get Property Compliance Data",
					"request": {
						"method": "GET",
