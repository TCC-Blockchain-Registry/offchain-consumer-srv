		{
			"name": "Transfers (Transferências)",
			"item": [
				{
					"name": "1. Configure Transfer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"from\": \"0x565524f400856766f11562832eB809d889491a01\",\n  \"to\": \"0x1234567890123456789012345678901234567890\",\n  \"matriculaId\": 123456,\n  \"approvers\": [\n    \"0xCARTORIO\",\n    \"0xPREFEITURA\",\n    \"0xIF\"\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/transfers/configure",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "configure"]
						},
						"description": "**PASSO 1:** Configura uma transferência com lista de aprovadores.\n\n💡 **Dica:** Use GET /api/approvers/recommended/list para obter a lista de aprovadores automaticamente.\n\n**IMPORTANTE:** Todos os aprovadores devem estar registrados no ApproversRegistry!"
					},
					"response": []
				},
				{
					"name": "2. Approve - Cartório",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"from\": \"0x565524f400856766f11562832eB809d889491a01\",\n  \"to\": \"0x1234567890123456789012345678901234567890\",\n  \"matriculaId\": 123456,\n  \"approverPrivateKey\": \"0xCARTORIO_PRIVATE_KEY\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/transfers/approve",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "approve"]
						},
						"description": "**PASSO 2.1:** Cartório aprova a transferência"
					},
					"response": []
				},
				{
					"name": "2. Approve - Prefeitura",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"from\": \"0x565524f400856766f11562832eB809d889491a01\",\n  \"to\": \"0x1234567890123456789012345678901234567890\",\n  \"matriculaId\": 123456,\n  \"approverPrivateKey\": \"0xPREFEITURA_PRIVATE_KEY\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/transfers/approve",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "approve"]
						},
						"description": "**PASSO 2.2:** Prefeitura aprova a transferência"
					},
					"response": []
				},
				{
					"name": "2. Approve - IF",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"from\": \"0x565524f400856766f11562832eB809d889491a01\",\n  \"to\": \"0x1234567890123456789012345678901234567890\",\n  \"matriculaId\": 123456,\n  \"approverPrivateKey\": \"0xIF_PRIVATE_KEY\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/transfers/approve",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "approve"]
						},
						"description": "**PASSO 2.3:** Instituição Financeira aprova a transferência"
					},
					"response": []
				},
				{
					"name": "3. Accept Transfer (Buyer)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"from\": \"0x565524f400856766f11562832eB809d889491a01\",\n  \"matriculaId\": 123456,\n  \"buyerPrivateKey\": \"0xBUYER_PRIVATE_KEY\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/transfers/accept",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "accept"]
						},
						"description": "**PASSO 3:** Comprador aceita a transferência"
					},
					"response": []
				},
				{
					"name": "4. Execute Transfer (Seller)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"to\": \"0x1234567890123456789012345678901234567890\",\n  \"matriculaId\": 123456,\n  \"sellerPrivateKey\": \"{{adminPrivateKey}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/transfers/execute",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "execute"]
						},
						"description": "**PASSO 4 (FINAL):** Vendedor executa a transferência.\n\nSó funciona se:\n✅ Todas aprovações registradas\n✅ Comprador aceitou\n✅ Propriedade regular"
					},
					"response": []
				},
				{
					"name": "Get Transfer Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/status?from=0x565524f400856766f11562832eB809d889491a01&to=0x1234567890123456789012345678901234567890&matriculaId=123456",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "status"],
							"query": [
								{
									"key": "from",
									"value": "0x565524f400856766f11562832eB809d889491a01"
								},
								{
									"key": "to",
									"value": "0x1234567890123456789012345678901234567890"
								},
								{
									"key": "matriculaId",
									"value": "123456"
								}
							]
						},
						"description": "Retorna status básico da transferência"
					},
					"response": []
				},
				{
					"name": "Get Transfer Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/details?from=0x565524f400856766f11562832eB809d889491a01&to=0x1234567890123456789012345678901234567890&matriculaId=123456",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "details"],
							"query": [
								{
									"key": "from",
									"value": "0x565524f400856766f11562832eB809d889491a01"
								},
								{
									"key": "to",
									"value": "0x1234567890123456789012345678901234567890"
								},
								{
									"key": "matriculaId",
									"value": "123456"
								}
							]
						},
						"description": "Retorna detalhes completos incluindo:\n- Quem já aprovou ✅\n- Quem falta aprovar ⏳\n- Se comprador aceitou\n- Se está pronta para executar\n- Próximo passo"
					},
					"response": []
				},
				{
					"name": "Check if Approver Approved",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/has-approved?from=0x565524f400856766f11562832eB809d889491a01&to=0x1234567890123456789012345678901234567890&matriculaId=123456&approver={{cartorioWallet}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "has-approved"],
							"query": [
								{
									"key": "from",
									"value": "0x565524f400856766f11562832eB809d889491a01"
								},
								{
									"key": "to",
									"value": "0x1234567890123456789012345678901234567890"
								},
								{
									"key": "matriculaId",
									"value": "123456"
								},
								{
									"key": "approver",
									"value": "{{cartorioWallet}}"
								}
							]
						},
						"description": "Verifica se um aprovador específico já aprovou"
					},
					"response": []
				}
			],
			"description": "Endpoints para gerenciar transferências de imóveis (4 passos: Configure → Approve → Accept → Execute)"
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		}
	]
}

