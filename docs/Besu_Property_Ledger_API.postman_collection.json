{
	"info": {
		"_postman_id": "offchain-consumer-api-v2",
		"name": "Offchain Consumer API (V2 - Atualizado)",
		"description": "API do Offchain Consumer para interação com smart contracts - Sistema de Aprovações V2\n\n## Arquitetura\n- Registro de propriedades requer 3 aprovações (Financial, Registry Office, Municipality)\n- Transferências requerem 3 aprovações + aceitação do comprador\n- Auto-registro de identidades (OnchainID) quando necessário\n\n## Variáveis\nConfigure no Environment:\n- `baseUrl`: http://localhost:3001\n- `requestHash`: Hash da solicitação (retornado ao criar request)\n- `matriculaId`: ID da matrícula da propriedade\n- `address`: Endereço Ethereum",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Properties",
			"item": [
				{
					"name": "Registrations",
					"item": [
						{
							"name": "Request Registration",
							"request": {
								"method": "POST",
								"header": [{"key": "Content-Type", "value": "application/json"}],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"matriculaId\": 456,\n  \"beneficiary\": \"0x3b59b80bef76afce7d0a0d19eeef73045a87816c\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/properties/approvals/request",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "approvals", "request"]
								},
								"description": "Solicita registro - fica pendente até 3 aprovações. Auto-registra identidade se necessário."
							}
						},
						{
							"name": "Approve - Financial",
							"request": {
								"method": "POST",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/approvals/{{requestHash}}/financial",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "approvals", "{{requestHash}}", "financial"]
								}
							}
						},
						{
							"name": "Approve - Registry Office",
							"request": {
								"method": "POST",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/approvals/{{requestHash}}/registry-office",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "approvals", "{{requestHash}}", "registry-office"]
								}
							}
						},
						{
							"name": "Approve - Municipality",
							"request": {
								"method": "POST",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/approvals/{{requestHash}}/municipality",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "approvals", "{{requestHash}}", "municipality"]
								},
								"description": "3ª aprovação - auto-executa o registro"
							}
						},
						{
							"name": "Get Status (PendingRegistration)",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/approvals/{{requestHash}}/status",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "approvals", "{{requestHash}}", "status"]
								},
								"description": "Consulta status de registro pendente"
							}
						}
					]
				},
				{
					"name": "Queries",
					"item": [
						{
							"name": "Get Property Details",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/{{matriculaId}}",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "{{matriculaId}}"]
								}
							}
						},
						{
							"name": "Get Owner",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/{{matriculaId}}/owner",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "{{matriculaId}}", "owner"]
								}
							}
						},
						{
							"name": "Check Exists",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/{{matriculaId}}/exists",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "{{matriculaId}}", "exists"]
								}
							}
						},
						{
							"name": "Get Properties of Owner",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/owner/{{address}}",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "owner", "{{address}}"]
								}
							}
						},
						{
							"name": "Count Properties",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/count/{{address}}",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "count", "{{address}}"]
								}
							}
						},
						{
							"name": "Get Compliance Status",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{baseUrl}}/api/properties/compliance/{{matriculaId}}",
									"host": ["{{baseUrl}}"],
									"path": ["api", "properties", "compliance", "{{matriculaId}}"]
								}
							}
						}
					]
				}
			]
		},
		{
			"name": "Transfers",
			"item": [
				{
					"name": "Request Transfer",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"from\": \"0x3b59b80bef76afce7d0a0d19eeef73045a87816c\",\n  \"to\": \"0x1f5c1eb46d627c1fc6d426f0979784331b0b29e7\",\n  \"matriculaId\": 456\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/transfers/request",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "request"]
						},
						"description": "Solicita transferência. Auto-registra identidade do comprador."
					}
				},
				{
					"name": "Approve - Financial",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/approvals/{{requestHash}}/financial",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "approvals", "{{requestHash}}", "financial"]
						}
					}
				},
				{
					"name": "Approve - Registry Office",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/approvals/{{requestHash}}/registry-office",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "approvals", "{{requestHash}}", "registry-office"]
						}
					}
				},
				{
					"name": "Approve - Municipality",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/approvals/{{requestHash}}/municipality",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "approvals", "{{requestHash}}", "municipality"]
						},
						"description": "3ª aprovação - auto-executa a transferência"
					}
				},
				{
					"name": "Get Status (PendingTransfer)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/transfers/approvals/{{requestHash}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "transfers", "approvals", "{{requestHash}}", "status"]
						},
						"description": "Consulta status de transferência pendente"
					}
				}
			]
		},
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						}
					}
				},
				{
					"name": "API Info",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3001"
		},
		{
			"key": "requestHash",
			"value": "0x..."
		},
		{
			"key": "matriculaId",
			"value": "456"
		},
		{
			"key": "address",
			"value": "0x3b59b80bef76afce7d0a0d19eeef73045a87816c"
		}
	]
}
